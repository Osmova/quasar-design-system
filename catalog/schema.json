{
  "$id": "qds/catalog/schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QDS shared catalog proof schema (development-only)",
  "description": "Subset frozen by parent in .claude/docs/variant-evolution-contracts.md. The checker implements this subset (structural validation); it is documentation plus the contract the scripts must satisfy, not a shipped package schema.",
  "type": "object",
  "required": ["schemaVersion", "title", "scope", "runtime", "hosts", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["kind", "note", "proofMode", "inventoryRule"],
      "properties": {
        "kind": { "const": "development-only" },
        "note": { "type": "string" },
        "proofMode": { "type": "string" },
        "inventoryRule": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["package", "controllerEntryRule", "injection", "persist"],
      "properties": {
        "package": { "type": "string" },
        "controllerEntryRule": { "type": "string" },
        "injection": {
          "type": "object",
          "required": ["key", "challengeOnRemoval"],
          "properties": {
            "key": { "const": "DESIGN_SYSTEM_THEME_KEY" },
            "challengeOnRemoval": { "type": "string" }
          }
        },
        "persist": { "const": false }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter", "setup", "kind"],
        "properties": {
          "adapter": { "type": "string" },
          "setup": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "family", "title", "order", "demo", "nativeExports", "controls",
          "fixtures", "subelements", "interaction", "hostIdMap", "disposition"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:/[a-z0-9]+)?$" },
          "family": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "demo": { "type": "string", "pattern": "^\\.\\/demos\\/.*\\.vue$" },
          "nativeExports": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^Q[A-Z]" } },
          "controls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "fixtures": { "type": "string", "pattern": "^\\.\\/fixtures\\/[a-z0-9-]+\\.fixture\\.json$" },
          "subelements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "interaction": {
            "type": ["object", "null"],
            "properties": {
              "portal": { "type": "boolean" },
              "keyboard": { "type": "string" },
              "teardown": { "type": "string" },
              "focus": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "viewport": { "type": ["object", "null"] },
          "optionalPeers": { "type": ["array", "null"], "items": { "type": "string" } },
          "hostIdMap": {
            "type": "object",
            "required": ["histoireVariantTitle", "storybookExport"],
            "properties": {
              "histoireVariantTitle": { "type": "string" },
              "storybookExport": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
            }
          },
          "disposition": { "enum": ["implemented", "planned"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

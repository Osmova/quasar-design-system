{
  "name": "@osmova/quasar-design-system",
  "version": "0.8.0-rc.3",
  "description": "Opinionated Quasar 2 design system inspired by Fluent 2, Apple, and One UI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/**/*.css",
    "src/**/*.scss",
    "src/fonts/**/*"
  ],
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/theme.d.ts",
      "import": "./dist/runtime/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./icons/quasar-icon-set": {
      "types": "./dist/icons/quasar-icon-set.d.ts",
      "import": "./dist/icons/quasar-icon-set.js"
    },
    "./qwindow": {
      "types": "./dist/qwindow.d.ts",
      "import": "./dist/qwindow.js"
    },
    "./css": "./src/css/index.scss",
    "./css/layered": "./src/css/index.layered.scss",
    "./css/extensions/qwindow": "./src/css/extensions/qwindow.scss",
    "./css/extensions/qwindow/layered": "./src/css/extensions/qwindow.layered.scss",
    "./quasar-variables": "./src/quasar.variables.scss",
    "./tokens/default": "./src/tokens/_default.scss",
    "./themes/default": "./src/themes/default.scss",
    "./themes/fallbacks": "./src/themes/fallbacks.scss",
    "./fonts/inter.css": "./src/fonts/inter.css",
    "./fonts/open-sans.css": "./src/fonts/open-sans.css",
    "./fonts/selawik.css": "./src/fonts/selawik.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "stories": "pnpm build && histoire dev",
    "stories:build": "pnpm build && histoire build",
    "catalog:generate": "node scripts/catalog-generate.mjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "catalog:check:complete": "node scripts/catalog-check.mjs --complete",
    "catalog:test": "node --test tests/catalog/*.test.mjs",
    "catalog:storybook": "pnpm -C examples/storybook storybook",
    "catalog:storybook:build": "pnpm -C examples/storybook build-storybook",
    "catalog:storybook:typecheck": "pnpm -C examples/storybook typecheck",
    "catalog:browser:test": "pnpm -C examples/storybook exec playwright test --config playwright.proof.config.ts",
    "gallery:dev": "pnpm -C examples/gallery dev",
    "gallery:build": "pnpm -C examples/gallery build",
    "gallery:test": "pnpm -C examples/gallery test:visual",
    "gallery:screens": "pnpm -C examples/gallery test:screens",
    "gallery:shadcn-reference:test": "pnpm -C examples/gallery exec playwright test --config playwright.shadcn-reference.config.ts",
    "shadcn-reference:build": "pnpm -C examples/shadcn-reference build",
    "shadcn-reference:check": "pnpm -C examples/shadcn-reference check:source && pnpm -C examples/shadcn-reference typecheck",
    "shadcn-reference:test": "pnpm shadcn-reference:build && pnpm -C examples/shadcn-reference test:reference",
    "test:runtime:ssr": "node --test tests/runtime/*.test.mjs",
    "test:runtime:colorjs": "node scripts/test-runtime-colorjs.mjs",
    "test:runtime:fill-contrast": "node scripts/test-runtime-fill-contrast.mjs",
    "test:runtime:grammar:browser": "node tests/runtime/grammar-fixture-browser.mjs",
    "test:runtime": "pnpm test:runtime:ssr && pnpm test:runtime:colorjs && pnpm test:runtime:fill-contrast && pnpm test:runtime:grammar:browser",
    "pack:dry": "npm pack --dry-run --json",
    "css:budget": "node scripts/css-budget.mjs",
    "verify:publish": "pnpm css:budget && pnpm build && pnpm typecheck && pnpm test:runtime && pnpm pack:dry",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm verify:publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osmova/quasar-design-system.git"
  },
  "keywords": [
    "quasar",
    "vue3",
    "design-system",
    "theme",
    "fluent",
    "one-ui",
    "apple"
  ],
  "author": "Bastien Viglianti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Osmova/quasar-design-system/issues"
  },
  "homepage": "https://github.com/Osmova/quasar-design-system#readme",
  "peerDependencies": {
    "@phosphor-icons/vue": "^2.0.0",
    "@quasar/quasar-ui-qwindow": "^3.0.0",
    "quasar": "^2.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/vue": {
      "optional": true
    },
    "@quasar/quasar-ui-qwindow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@quasar/quasar-ui-qwindow": "^3.0.2",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "colorjs.io": "0.7.1",
    "histoire": "1.0.0-beta.1",
    "quasar": "^2.35.0",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19 <27"
  },
  "dependencies": {
    "quasar-extras-svg-icons": "^3.4.0"
  }
}
